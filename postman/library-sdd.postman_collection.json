{
  "info": {
    "name": "library-sdd (Book Return Module)",
    "description": "Run top to bottom on FRESH demo data (app.seed.enabled=true, empty tables). Folders 1-5 depend on each other: logins save tokens into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth (log in first)",
      "item": [
        {
          "name": "Login as staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff\",\n  \"password\": \"staff123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"staffToken\", t.accessToken);",
                  "pm.collectionVariables.set(\"staffRefresh\", t.refreshToken);",
                  "pm.test(\"got both tokens\", () => { pm.expect(t.accessToken).to.be.a(\"string\"); pm.expect(t.expiresIn).to.eql(900); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as reader1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader1\",\n  \"password\": \"reader123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"readerToken\", t.accessToken);",
                  "pm.collectionVariables.set(\"readerRefresh\", t.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "AC-A2 wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "",
                  "pm.test(\"INVALID_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_CREDENTIALS\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Staff: book return",
      "item": [
        {
          "name": "US-1 Look up reader RC0001",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/readers/RC0001/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "readers",
                "RC0001",
                "loans"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json();",
                  "pm.test(\"reader is R001\", () => pm.expect(d.reader.code).to.eql(\"R001\"));",
                  "console.log(\"Unreturned:\", d.unreturnedItems.map(i => i.bookBarcode + \" \" + i.borrowDate + (i.late ? \" LATE\" : \"\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "US-2 Preview B0001 (late) + B0003 (on time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/staff/returns/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "returns",
                "preview"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readerCardBarcode\": \"RC0001\",\n  \"bookBarcodes\": [\n    \"B0001\",\n    \"B0003\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json();",
                  "pm.test(\"preview saves nothing (returnId null)\", () => pm.expect(d.returnId).to.eql(null));",
                  "pm.test(\"fine 20,000\", () => pm.expect(d.fineSlip.totalFine).to.eql(20000));"
                ]
              }
            }
          ]
        },
        {
          "name": "US-4 Confirm, reader can't pay -> late copy stays",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/staff/returns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "returns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readerCardBarcode\": \"RC0001\",\n  \"bookBarcodes\": [\n    \"B0001\",\n    \"B0003\"\n  ],\n  \"finePaid\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json();",
                  "pm.test(\"B0003 returned, B0001 kept\", () => {",
                  "  pm.expect(d.returnedItems.map(i => i.bookBarcode)).to.eql([\"B0003\"]);",
                  "  pm.expect(d.keptOnLoanItems.map(i => i.bookBarcode)).to.eql([\"B0001\"]);",
                  "  pm.expect(d.fineSlip).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "US-3 Confirm B0001, fine paid -> fine slip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/staff/returns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "returns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readerCardBarcode\": \"RC0001\",\n  \"bookBarcodes\": [\n    \"B0001\"\n  ],\n  \"finePaid\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json();",
                  "pm.test(\"fine slip 20,000\", () => pm.expect(d.fineSlip.totalFine).to.eql(20000));",
                  "pm.test(\"returnId set\", () => pm.expect(d.returnId).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
